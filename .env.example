# Configuration de l'application - Copiez ce fichier vers .env et remplissez les valeurs

# Base de données
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medibook
DB_USERNAME=postgres
DB_PASSWORD=votre_mot_de_passe_bdd

# Serveur
SERVER_PORT=8085

# JWT
JWT_SECRET=votre_secret_jwt_très_long_et_complexe

# Cloudinary
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
